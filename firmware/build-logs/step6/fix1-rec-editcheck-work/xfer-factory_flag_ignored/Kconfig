config RING_XFER_LOGIC
	bool "Ring USB transfer: protocol and descriptor tables (pure part, no kernel call)"
	select CRC
	help
	  The 16-byte header, CRC-32, status codes, opcode table, argument limits and response layouts of
	  design/firmware.md section 6, and the descriptor tables of the vendor class.

config RING_XFER
	bool "Ring USB transfer: the vendor class and its thread (thin part, reaches hardware only through ring_rhw)"
	depends on RING_RHW
	select RING_XFER_LOGIC
	help
	  The transfer thread, the stack enabled on VBUS ready and disabled on VBUS removed, the request reader and the
	  BUSY answer (design/firmware.md section 6).

if RING_XFER

config RING_XFER_STACK_SIZE
	int "Stack of the transfer thread (bytes)"
	default 4096

config RING_XFER_THREAD_PRIO
	int "Priority of the transfer thread (preemptible, higher number = lower priority)"
	default 6

config RING_XFER_SEND_TIMEOUT_MS
	int "Time one send may take before the host is taken as stopped (ms)"
	default 2000

config RING_XFER_RESYNC_MS
	int "Silence on the bulk OUT pipe after which a half-read request is dropped (ms)"
	default 100

endif
