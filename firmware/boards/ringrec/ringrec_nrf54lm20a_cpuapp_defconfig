# The ring (software step 7): the same base as the development kit's cpuapp defconfig.

# debug log on uart20, send only (design/firmware.md, peripheral table: Debug log)
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

CONFIG_GPIO=y

CONFIG_ARM_MPU=y
# as the kit: the 0x0 to 0x400 area is unmapped on this chip
CONFIG_NULL_POINTER_EXCEPTION_DETECTION_NONE=y

CONFIG_CACHE_MANAGEMENT=y
CONFIG_EXTERNAL_CACHE=y

CONFIG_NRF_GRTC_START_SYSCOUNTER=y
