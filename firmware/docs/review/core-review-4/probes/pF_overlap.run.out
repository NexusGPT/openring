EXITS RECOVERY: 9(SCAN_DONE) 10(SCAN_DONE) 11(SCAN_READ_ERROR)
EXITS STANDBY: 12(LONG_PRESS) 13(LONG_PRESS) 18(MENU_POWER_OFF) 19(VBUS_IN) 21(BATT_B5) 22(BATT_B2) 23(STORAGE_SFULL) 24(STORAGE_FAULT_SET)
EXITS RECORDING: 25(LONG_PRESS) 29(VBUS_IN) 31(BATT_B5) 32(BATT_B2) 34(STORAGE_SFULL) 35(CHUNK_WRITE_FAILED) 36(MIC_NO_BLOCK) 37(POWER_LOSS)
EXITS CHARGING: 38(USB_CONFIGURED) 39(VBUS_OUT) 40(VBUS_OUT) 41(VBUS_OUT) 42(VBUS_OUT) 43(CHARGE_ERROR)
EXITS TRANSFER: 45(USB_UNCONFIGURED) 46(VBUS_OUT) 47(FW_END) 48(FACTORY_ENTER)
EXITS ERR_STORAGE_FULL: 50(VBUS_IN) 52(BATT_B5) 53(BATT_B2)
EXITS ERR_BATTERY_LOW: 54(VBUS_IN) 56(BATT_B2)
EXITS ERR_STORAGE_FAULT: 57(VBUS_IN) 59(STORAGE_RETRY_OK) 60(STORAGE_RETRY_OK) 62(BATT_B2)
EXITS ERR_MIC_FAULT: 63(TIMER_5S) 64(VBUS_IN) 65(BATT_B2)
EXITS ERR_CHARGER: 66(VBUS_OUT) 67(BATT_B2)
EXITS FACTORY_TEST: 68(FACTORY_EXIT) 69(SHIP_ENTER) 70(SHIP_SAMPLE) 71(VBUS_OUT)
exit 0
