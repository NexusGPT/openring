# Ring OS application options. Later steps add their options here.

config RING_PAIR_WINDOW_AT_BOOT
	bool "Open the pairing window at boot while no device is paired"
	help
	  A stand-in for the pairing screen, which comes with the Screens part:
	  lets the development kit pair with a phone or a computer. The passkey is
	  printed on the console. Off in the product.

source "Kconfig.zephyr"
