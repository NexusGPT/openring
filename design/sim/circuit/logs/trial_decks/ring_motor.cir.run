* ring test 1: motor start 175 mA and run 80 mA with a recording running
* generated by make_decks.py from design/ecad/ring
.include "design/sim/circuit/models/tlv755p30.lib"
.include "design/sim/circuit/models/npm1304.lib"
.param ocv=3.45
.param rcell=1.9565
.param icl=0.56
.param rdo=0.65
CC4 n_VDD_1V8 0 1e-05 ; 10uF
CC5 n_VDD_1V8 0 1e-07 ; 100nF
CC1 n_VDD_1V8 0 1e-07 ; 100nF
CC2 n_VDD_1V8 0 1e-07 ; 100nF
CC71 n_VBUS 0 1e-06 ; 1.0uF 25V
CC85 n_VBAT 0 2.2e-06 ; 2.2uF
CC88 n_VSYS 0 1e-05 ; 10uF
CC86 n_VDD_MIC 0 1e-06 ; 1.0uF
CC87 n_VDD_SD 0 1e-06 ; 1.0uF
CC72 n_VBUS 0 1e-07 ; 100nF
CC73 n_VBUSOUT 0 1e-06 ; 1.0uF
CC74 n_VSYS 0 1e-05 ; 10uF
CC75 n_VSYS 0 1e-05 ; 10uF
CC76 n_VSYS 0 1e-09 ; 1.0nF
CC77 n_VSYS 0 1e-09 ; 1.0nF
CC78 n_VDD_1V8 0 1e-05 ; 10uF
CC79 n_VDD_3V0 0 1e-05 ; 10uF
CC80 n_VDD_1V8 0 1e-07 ; 100nF
RR71 n_VSET1 0 47000 ; 47k
RR72 n_VSET2 0 150000 ; 150k
CC31 n_VDD_MIC 0 1e-06 ; 1uF
CC35 n_VDD_MIC 0 1e-07 ; 100nF Class 1
CC32 n_VDD_MIC 0 1e-06 ; 1uF
CC36 n_VDD_MIC 0 1e-07 ; 100nF Class 1
CC81 n_VDD_1V8 0 1e-07 ; 100nF
CC82 n_VDD_SD 0 1e-07 ; 100nF
CC60 n_VDD_SD 0 4.7e-06 ; 4.7uF
CC61 n_VDD_SD 0 1e-07 ; 100nF
CC21 n_VBAT 0 4.7e-06 ; 4.7uF
CC83 n_VBAT 0 1e-05 ; 10uF
CC84 n_VMOT 0 1e-05 ; 10uF
RR61 n_MOTOR n_MOT_EN 100 ; 100R
RR62 n_MOT_EN 0 100000 ; 100k
* BT1 cell: 4.35V 20-27mAh at US9 (17.6mAh min at US7) curved ; capacity floor 17.6 mAh (US 7) is read from parts.csv, open-circuit voltage and resistance are test parameters
Vocv cell_i 0 PWL(0 0 100u {ocv})
Rcell cell_i n_VBAT {rcell}
Vvbus n_VBUS 0 DC 0 ; no case present
Vls1 ls1en 0 PWL(0 0 10m 0 10.001m 1)
Vls2 ls2en 0 PWL(0 0 5m 0 5.001m 1)
Vchg chgen 0 0
XU2 n_VBUS n_VBUSOUT n_VSYS n_VBAT n_VDD_1V8 n_VDD_3V0 n_VDD_1V8 n_VDD_MIC n_VDD_3V0 n_VDD_SD n_VSET1 n_VSET2 ls1en ls2en chgen NPM1304
XU11 n_VBAT n_VMOT n_MOT_EN 0 TLV755P30 params: icl={icl} rdo={rdo}
Vmotor n_MOTOR 0 PWL(0 0 0.03 0 0.030001 1.8 0.11 1.8 0.110001 0)
* M1 motor: resistance = 3.0 V / 175 mA for the first 0.01 s of the pulse, then 3.0 V / 80 mA (Jinlong W0525AB001D spec p6 item 3-1-5: starting current below 175 mA at 3.0 V, rotor held; ESTIMATE of ecad/motor-drive/motor-drive.md line 153: start time 10 ms (the maker states none))
Bm n_VMOT 0 I = v(n_VMOT) / ((time < 0.04) ? 17.1429 : 37.5)
Iu1 n_VDD_1V8 0 0.003 ; architecture.md line 89: main chip 3.0 mA at 1.8 V, estimate
Imic5 n_VDD_MIC 0 0.00063 ; U5 firmware.md 8.5: SPK0641HT4H-1 draws 0.63 mA at 1.8 V
Imic6 n_VDD_MIC 0 0.00063 ; U6, same
Isd n_VDD_SD 0 0.025 ; U3 CS CSNP32GCR01-BOW datasheet p8 IOP write 25 mA max (motor-drive.md 2.4)
Ivci n_VDD_3V0 0 0.0032 ; architecture.md line 101: screen VCI 3.2 mA
Iiov n_VDD_1V8 0 0.001 ; architecture.md line 101: screen IOVCC 1 mA
Bscr n_VBAT 0 I = 0.04424 / max(v(n_VBAT), 1) ; U4 panel supply on VBAT: architecture.md line 101: screen on, full white, about 55 mW minus VCI and IOVCC power
.tran 20u 0.14 uic
.control
run
meas tran vbat_min min v(n_VBAT) from=0.03 to=0.13
meas tran v18_min min v(n_VDD_1V8) from=0.03 to=0.13
meas tran v18_max max v(n_VDD_1V8) from=0.03 to=0.13
meas tran v30_min min v(n_VDD_3V0) from=0.03 to=0.13
meas tran v30_max max v(n_VDD_3V0) from=0.03 to=0.13
meas tran vmot_min min v(n_VMOT) from=0.0311 to=0.1099
meas tran vsys_min min v(n_VSYS) from=0.03 to=0.13
meas tran ibat_max max i(v.xu2.vsb) from=0.03 to=0.13
meas tran ildo_max max i(v.xu11.vs) from=0.03 to=0.13
meas tran icell_min min i(vocv) from=0.03 to=0.13
meas tran ibuck2_max max i(v.xu2.vsn2) from=0.03 to=0.13
meas tran vmot_max max v(n_VMOT) from=0.0 to=0.0299
echo RESULT motor.vbat_min = $&vbat_min
echo RESULT motor.v18_min = $&v18_min
echo RESULT motor.v18_max = $&v18_max
echo RESULT motor.v30_min = $&v30_min
echo RESULT motor.v30_max = $&v30_max
echo RESULT motor.vmot_min = $&vmot_min
echo RESULT motor.vsys_min = $&vsys_min
echo RESULT motor.ibatpath_max = $&ibat_max
echo RESULT motor.ildo_max = $&ildo_max
echo RESULT motor.icell_min = $&icell_min
echo RESULT motor.ibuck2_max = $&ibuck2_max
echo RESULT motor.vmot_before = $&vmot_max
wrdata results/t1_wave.txt v(n_VBAT) v(n_VSYS) v(n_VDD_1V8) v(n_VDD_3V0) v(n_VMOT) v(n_VDD_SD)
quit
.endc
.end
* included: C4 C5 C1 C2 C71 C85 C88 C86 C87 C72 C73 C74 C75 C76 C77 C78 C79 C80 R71 R72 C31 C35 C32 C36 C81 C82 C60 C61 C21 C83 C84 R61 R62 BT1 U2 U11 M1 U5 U6 U3 U4 DISP1
* excluded: L1(net outside this test: DCC,DECD) C6(net outside this test: DECD) FB1(net outside this test: DECA,DECD) C7(net outside this test: DECA) C14(net outside this test: DECA) C10(net outside this test: VDD_USB_3V3) R1(net outside this test: U1_VBUS) C11(net outside this test: U1_VBUS) R2(net outside this test: TXRTUNE) L2(net outside this test: ANT1_NODE,ANT2_NODE) C3(net outside this test: ANT2_NODE) L3(net outside this test: ANT2_NODE,ANT3_NODE) C12(net outside this test: ANT3_NODE) L4(net outside this test: ANT3_NODE,RF_FEED) C13(DNP) L71(net outside this test: SW1) L72(net outside this test: SW2) RT1(net outside this test: NTC) R57(net outside this test: PMIC_SDA) R58(net outside this test: PMIC_SCL) R31(net outside this test: MIC1_DATA,MIC_A_DATA) R32(net outside this test: MIC2_DATA,MIC_A_DATA) R60(net outside this test: SDC_MISO) R63(net outside this test: SD_DAT1) R64(net outside this test: SD_DAT2) R65(net outside this test: SDC_CS) L10(net outside this test: SGM_SW1,SGM_SW2) C22(net outside this test: SGM_AVIN) C23(net outside this test: SGM_C1N,SGM_C1P) C24(net outside this test: SGM_VOUT) C25(net outside this test: ELVDD) C26(net outside this test: SGM_AVDD) C27(net outside this test: SGM_VON) C28(net outside this test: ELVSS) C29(net outside this test: ELVSS) R66(net outside this test: OLED_PWR_EN)
