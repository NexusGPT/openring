line = [l for l in sec13.splitlines() if l.startswith('- Pin table')][0]
line = line.split('As printed')[0].split('15 pins:')[1]
printed = []
for m in re.finditer(r'\b(\d+)(?:-(\d+))? ([A-Z]{2,}[A-Z0-9]*)\b', line):
