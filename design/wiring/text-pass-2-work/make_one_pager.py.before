#!/usr/bin/env python3
"""One-page description of the ring for a first contact with a Chinese maker: page 1 English, page 2 Chinese.

Run:  design/.venv/bin/python design/supplier-package/make_one_pager.py <out.pdf> <package folder> [<preview-prefix>]
<package folder> is the built supplier package (the folder that holds MANIFEST.csv). Every count on the page (files, parts-list
lines, custom parts, drawing sheets, case size) is read from that folder; the script stops if the package is missing or its
manifest does not match its files. No drawing and no file of the design is in the PDF.
"""
import csv
import re
import sys
import unicodedata
from pathlib import Path

import matplotlib
matplotlib.use("Agg")
from matplotlib import font_manager
from matplotlib.backends.backend_pdf import PdfPages
import matplotlib.pyplot as plt

FONT = "/Library/Fonts/Arial Unicode.ttf"
BOLD = "/System/Library/Fonts/Supplemental/Arial Bold.ttf"
REG = font_manager.FontProperties(fname=FONT)
BLD = font_manager.FontProperties(fname=BOLD)

W, H = 8.27, 11.69            # A4, inches
LEFT, RIGHT, TOP = 0.085, 0.915, 0.955   # figure fractions
WIDTH_PT = (RIGHT - LEFT) * W * 72

def facts(pkg):
    """counts read from the built package folder (never typed)"""
    pkg = Path(pkg)
    man = list(csv.DictReader(open(pkg / "MANIFEST.csv", encoding="utf-8")))
    listed = sorted(r["path"] for r in man) + ["MANIFEST.csv"]
    onDisk = sorted(f.relative_to(pkg).as_posix() for f in pkg.rglob("*") if f.is_file())
    if listed != onDisk:
        raise SystemExit("the package folder does not match its MANIFEST.csv: " + str(len(listed)) + " listed, " + str(len(onDisk)) + " on disk")
    idx = list(csv.DictReader(open(pkg / "02-3d/maker-files/index.csv", encoding="utf-8")))
    size = (pkg / "02-3d/case/case_size.txt").read_text(encoding="utf-8")
    ms = re.search(r"X ([\d.]+) mm x Y ([\d.]+) mm x Z ([\d.]+) mm", size)
    return {"files": len(onDisk),
            "bom": len(list(csv.DictReader(open(pkg / "03-parts-lists/ring-parts-list.csv", encoding="utf-8")))),
            "parts": len({r["part"] for r in idx} - {"ring-assembly"}),
            "drawings": sum(1 for f in onDisk if f.startswith("05-mechanical/drawings/") and f.endswith(".pdf")),
            "case": " x ".join(ms.groups()) + " mm"}


EN = {
    "title": "Smart ring voice recorder: manufacturing partner wanted",
    "sub": "Custom design, owned by the sender. Confidential summary, no drawings attached.",
    "from": "From: [company, contact person, e-mail]          Date: [date]",
    "sections": [
        ("The product", [
            "A smart ring that records meetings into its own memory. A long press on its one control (a five-way joystick with a round cap) starts and stops a recording. A small AMOLED screen sits on top; it shows that the ring records. There is no recording light.",
            "Body: titanium grade 5, or stainless steel 316L. Block on top 29.3 x 14.75 x 3.85 mm. Band 8.0 mm wide and 2.6 mm thick. Seven sizes, US 7 to US 13.",
            "Inside: Nordic nRF54LM20A Bluetooth LE chip, Nordic nPM1304 power chip, 2 MEMS microphones, 4 GB storage, a vibration motor, a five-way joystick, a custom curved lithium polymer cell (4.35 V type, 18 to 32 mAh by ring size).",
            "The inside of the band is closed by a resin liner cast in place. Four charging pads sit in the liner.",
            "Charging case, {case}: USB-C, 700 mAh cell, four spring pins in a moulded pin holder. It charges the ring and moves the recordings over USB.",
        ]),
        ("What is ready", [
            "Design state: inside model version 7 and charging case C5d. The full design package holds {files} files.",
            "3D models (STEP) and files for 3D-printed fit samples (STL): the exterior for each ring size, the complete inside assembly, {parts} custom parts (per ring size where they change by size), the charging case.",
            "Parts list ({bom} lines), wiring diagram (KiCad and PDF), {drawings} drawing sheets and one specification page per custom part, the assembly order, the software behaviour specification with the factory test list.",
            "Not ready: the circuit board layout (who routes it is not decided), the software code, a working sample. Not confirmed by a maker: the case's spring pin and the pin holder's 0.79 mm walls.",
        ]),
        ("What we look for", [
            "A factory that builds our design (JDM or contract manufacturing). We do not look for an existing ring with our logo.",
            "Work wanted: a design-for-manufacturing review; as an option the circuit board layout and the software; prototypes; then series production.",
            "Quantities: [number] prototypes, then [number] per order. First samples wanted by: [date].",
        ]),
        ("Please answer", [
            "1. Have you built a smart ring from a customer's own design? One with a screen? Please name examples you may share.",
            "2. Which of these do you do in your own factory: titanium machining or metal injection moulding, curved cover glass, flexible circuits and 0201 assembly, resin potting of rings, waterproof testing?",
            "3. Can you source a custom curved cell (for example from Grepow) and the Nordic chips?",
            "4. For a product of this kind: your smallest order, engineering fee, tooling cost and sample lead time.",
            "5. Your certificates (ISO 9001, ISO 13485, BSCI) and your export experience to the EU (CE, RoHS, UN 38.3).",
            "6. Will you sign an NNN agreement (no disclosure, no use, no circumvention), in Chinese and English under Chinese law, before we send the files?",
        ]),
    ],
    "next": "Next step: send your answers to [e-mail]. After the signed agreement we send the full design package (3D models, parts lists, wiring diagrams, specifications, assembly order, test list).",
}

ZH = {
    "title": "智能戒指录音器：寻找制造合作伙伴",
    "sub": "发件方自有的定制设计。保密摘要，不含图纸。",
    "from": "发件方：[公司、联系人、邮箱]          日期：[日期]",
    "sections": [
        ("产品简介", [
            "一款可将会议录音保存到自身存储器的智能戒指。长按唯一的控制键（带圆形键帽的五向摇杆）即可开始和停止录音。顶部带有小型 AMOLED 显示屏，屏幕显示戒指正在录音。没有录音指示灯。",
            "壳体：5 级钛合金，或 316L 不锈钢。顶部模块 29.3 x 14.75 x 3.85 mm。戒圈宽 8.0 mm、厚 2.6 mm。共 7 个尺码，美码 7 至 13。",
