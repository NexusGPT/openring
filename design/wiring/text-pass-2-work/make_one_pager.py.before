    "next": "下一步：请将答复发送至 [邮箱]。协议签署后，我方将提供完整的设计资料包（3D 模型、物料清单、原理图、规格书、装配工序、测试清单）。",
}


LATIN = 0.47   # width of a Latin character in em; set per page in page()
NO_START = "。，、；：？！）》】"   # never at the start of a line


def units(ch):
    return 1.0 if unicodedata.east_asian_width(ch) in ("W", "F") else LATIN


def wrap(text, size, indent_pt=0.0):
    """Greedy wrap by estimated width. Latin words stay whole; wide characters may break anywhere."""
    limit = (WIDTH_PT - indent_pt) / size
    lines, cur, cur_w = [], "", 0.0
    token = ""
    def flush_token():
        nonlocal cur, cur_w, token
        if not token:
            return
        tw = sum(units(c) for c in token)
        if cur and cur_w + tw > limit:
            lines.append(cur.rstrip()); cur, cur_w = "", 0.0
            token_l = token.lstrip()
            tw = sum(units(c) for c in token_l)
            cur, cur_w = token_l, tw
        else:
            cur += token; cur_w += tw
        token = ""
    for ch in text:
        if ch in NO_START:
            flush_token(); cur += ch; cur_w += units(ch)
        elif unicodedata.east_asian_width(ch) in ("W", "F"):
            flush_token(); token = ch; flush_token()
        elif ch == " ":
            token += ch; flush_token()
        else:
            token += ch
    flush_token()
    if cur:
        lines.append(cur.rstrip())
    return lines


def page(pdf, doc, base, preview=None, latin=0.47):
    global LATIN
    LATIN = latin
    fig = plt.figure(figsize=(W, H))
    y = TOP
    def put(text, size, bold=False, x=LEFT, color="#15171b", gap=1.45):
        nonlocal y
        fp = (BLD if bold and all(ord(c) < 0x2E80 for c in text) else REG).copy()
        fp.set_size(size)
        fig.text(x, y, text, fontproperties=fp, color=color, va="top", ha="left")
        y -= size * gap / 72 / H
    put(doc["title"], base + 7.5, bold=True, gap=1.5)
    put(doc["sub"], base + 0.5, color="#5d636c", gap=1.7)
    put(doc["from"], base, gap=2.0)
    line = plt.Line2D([LEFT, RIGHT], [y + 0.004, y + 0.004], transform=fig.transFigure, color="#c9ccd0", lw=0.8)
    fig.add_artist(line)
    y -= 0.008
    for head, items in doc["sections"]:
        put(head, base + 2.5, bold=True, gap=1.7)
        for it in items:
            numbered = it[:2] in ("1.", "2.", "3.", "4.", "5.", "6.")
            indent = 12.0
            lines = wrap(it if numbered else it, base, indent_pt=indent)
            for i, ln in enumerate(lines):
                if i == 0 and not numbered:
                    fpb = REG.copy(); fpb.set_size(base)
                    fig.text(LEFT, y, "•", fontproperties=fpb, va="top", ha="left")
                put(ln, base, x=LEFT + indent / 72 / W, gap=1.42)
            y -= 0.0035
        y -= 0.006
    line = plt.Line2D([LEFT, RIGHT], [y + 0.004, y + 0.004], transform=fig.transFigure, color="#c9ccd0", lw=0.8)
    fig.add_artist(line)
    y -= 0.008
    for ln in wrap(doc["next"], base):
        put(ln, base, gap=1.42)
    fp = REG.copy(); fp.set_size(7.5)
    fig.text(LEFT, 0.035, "Confidential. For assessment only. Do not copy or pass on.   保密文件，仅供评估，请勿复制或转发。", fontproperties=fp, color="#8a9099", va="bottom")
    if y < 0.06:
        raise SystemExit(f"text runs off the page (y={y:.3f}): shorten it or lower the font size")
    pdf.savefig(fig)
    if preview:
        fig.savefig(preview, dpi=110)
    plt.close(fig)
    return y


def fill(doc, f):
    d = dict(doc)
    d["sections"] = [(h, [it.format(**f) for it in items]) for h, items in doc["sections"]]
    return d


def main():
    if len(sys.argv) < 3:
        raise SystemExit("usage: make_one_pager.py <out.pdf> <package folder> [<preview-prefix>]")
    out = Path(sys.argv[1])
    f = facts(sys.argv[2])
    prev = sys.argv[3] if len(sys.argv) > 3 else None
    print("facts from the package:", f)
    with PdfPages(out) as pdf:
        y1 = page(pdf, fill(EN, f), 9.8, prev + "-en.png" if prev else None, latin=0.475)
        y2 = page(pdf, fill(ZH, f), 10.4, prev + "-zh.png" if prev else None, latin=0.60)
    print(f"written {out}; lowest text line at {y1:.3f} (English) and {y2:.3f} (Chinese) of the page height")


if __name__ == "__main__":
    main()
