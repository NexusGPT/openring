> # ---------- controls on the real table: the ring board's paste regions moved 1.0 mm off their lands ----------
> def shift_regions(src, dst, dy_mm):
>     out, inreg = [], False
>     for l in open(src, encoding="utf-8"):
>         s = l.strip()
>         if s.startswith("G36"):
>             inreg = True
>         if s.startswith("G37"):
>             inreg = False
>         if inreg:
>             l = re.sub(r"Y(-?\d+)", lambda m: "Y%d" % (int(m.group(1)) + int(dy_mm * 1e6)), l)
>         out.append(l)
>     with open(dst, "w", encoding="utf-8") as f:
>         f.write("".join(out))
