{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "open-items.schema.json",
  "type": "object",
  "properties": {
    "supplier_requests": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/SupplierRequest"
      }
    },
    "bench_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "$ref": "common.schema.json#/$defs/Source"
          }
        },
        "required": [
          "id",
          "title",
          "detail",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "$ref": "common.schema.json#/$defs/Source"
          }
        },
        "required": [
          "id",
          "text",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "$ref": "common.schema.json#/$defs/IsoDate"
          },
          "speaker": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "$ref": "common.schema.json#/$defs/Source"
          }
        },
        "required": [
          "date",
          "speaker",
          "quote",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "supplier_requests",
    "bench_tests",
    "risks",
    "decisions"
  ],
  "additionalProperties": false,
  "title": "OpenItems",
  "description": "open.json: architecture sections 12 and 13, risks, the owner dated decisions. Case supplier items are in the case record."
}
