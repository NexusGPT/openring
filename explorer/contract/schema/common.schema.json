{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "common",
  "description": "Shared definitions used by every record schema.",
  "$defs": {
    "Source": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "file",
        "line"
      ],
      "additionalProperties": false,
      "title": "Source",
      "description": "Where a value comes from: a path relative to the repository root and a 1-based line, or null when the whole file is the source."
    },
    "Sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Source"
      },
      "minItems": 1
    },
    "Status": {
      "type": "string",
      "enum": [
        "ok",
        "missing",
        "unparsed",
        "stale"
      ]
    },
    "AreaId": {
      "type": "string",
      "enum": [
        "look",
        "inside",
        "electronics",
        "board",
        "parts",
        "behaviour",
        "case",
        "open"
      ]
    },
    "AreaState": {
      "type": "string",
      "enum": [
        "done",
        "in progress",
        "not started",
        "waiting on a supplier",
        "state unknown"
      ]
    },
    "Bom": {
      "type": "string",
      "enum": [
        "ring",
        "case"
      ]
    },
    "PartId": {
      "type": "string",
      "pattern": "^(ring|case):[A-Za-z0-9][A-Za-z0-9_.+/-]*$",
      "description": "'<bom>:<ref>' with bom in {ring, case}"
    },
    "Evidence": {
      "type": "string",
      "enum": [
        "DS",
        "LIST",
        "CALC",
        "BENCH"
      ]
    },
    "RelPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/].*$",
      "description": "Forward-slash path relative to the repository root, never absolute, never containing .."
    },
    "Vec3": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false
    },
    "IsoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "Fact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "common.schema.json#/$defs/Source"
        }
      },
      "required": [
        "id",
        "label",
        "value",
        "unit",
        "source"
      ],
      "additionalProperties": false,
      "title": "Fact",
      "description": "One value with its unit and its source. The app renders it, never computes it."
    },
    "Table": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "source": {
          "$ref": "common.schema.json#/$defs/Source"
        }
      },
      "required": [
        "columns",
        "rows",
        "source"
      ],
      "additionalProperties": false,
      "title": "Table",
      "description": "A table copied from a source document: every row has one cell per column."
    },
    "SupplierRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "item": {
          "type": "string",
          "minLength": 1
        },
        "who": {
          "type": "string",
          "minLength": 1
        },
        "ask": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "common.schema.json#/$defs/Source"
        }
      },
      "required": [
        "id",
        "item",
        "who",
        "ask",
        "section",
        "source"
      ],
      "additionalProperties": false,
      "title": "SupplierRequest"
    },
    "Kind": {
      "type": "string",
      "enum": [
        "finish metal",
        "glass",
        "screen",
        "light",
        "satin",
        "matte",
        "gold",
        "plain"
      ]
    }
  }
}
