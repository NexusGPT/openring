{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "area-states.schema.json",
  "type": "object",
  "properties": {
    "design_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/IsoDate"
        },
        {
          "type": "null"
        }
      ]
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/AreaId"
          },
          "state": {
            "$ref": "common.schema.json#/$defs/AreaState"
          },
          "why": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "who": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "basis_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "current_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "stale": {
            "type": "boolean"
          },
          "source": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/Source"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "state",
          "why",
          "who",
          "basis_version",
          "current_version",
          "stale",
          "source"
        ],
        "additionalProperties": false
      },
      "minItems": 8,
      "maxItems": 8
    },
    "look": {
      "type": "object",
      "properties": {
        "picked": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "in_design": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "picked",
        "rejected",
        "in_design"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "design_version",
    "updated",
    "areas",
    "look"
  ],
  "additionalProperties": false,
  "title": "AreaStates",
  "description": "areas.json: always 8 areas. Without a status file every area says 'state unknown'."
}
